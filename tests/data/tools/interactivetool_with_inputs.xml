<tool id="interactivetool_with_inputs" name="interactivetool_with_inputs" tool_type="interactive" version="0.1">
    <description>Interactive tool that requires a parameter (for testing --test_index).</description>
    <requirements>
        <container type="docker">galaxy/test-http-example:0.1</container>
    </requirements>
    <entry_points>
        <entry_point name="IT with inputs" requires_domain="True">
            <port>7000</port>
            <url>/</url>
        </entry_point>
    </entry_points>
    <command detect_errors="exit_code"><![CDATA[
        cd /;
        echo "$greeting" > index.html;
        python -m SimpleHTTPServer 7000
    ]]>
    </command>
    <inputs>
        <param name="greeting" type="text" label="Greeting" optional="false">
            <initial_value>moo cow</initial_value>
        </param>
    </inputs>
    <outputs>
    </outputs>
    <tests>
        <test>
            <param name="greeting" value="moo cow" />
        </test>
        <test>
            <param name="greeting" value="baa sheep" />
        </test>
    </tests>
    <help>
        Interactive tool that requires a parameter, for testing planemo test_interactive --test_index.
    </help>
</tool>
