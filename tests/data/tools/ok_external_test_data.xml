<tool id="external_test_data_copy" name="Copy Dataset" version="1.0">
    <description>copies a dataset whose test data lives outside the tool directory</description>
    <command>
        cp '$input1' '$output'
    </command>
    <inputs>
        <param name="input1" type="data" format="txt" label="Input Dataset"/>
    </inputs>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test>
            <param name="input1" value="planemo_external_test_data.txt"/>
            <output name="output" file="planemo_external_test_data.txt"/>
        </test>
    </tests>
    <help>
        Some Awesome Help!
    </help>
    <citations>
        <citation type="doi">10.1101/014043</citation>
    </citations>
</tool>
