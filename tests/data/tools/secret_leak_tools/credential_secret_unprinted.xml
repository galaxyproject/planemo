<tool id="credential_secret_unprinted" name="credential_secret_unprinted" version="1.0.0" profile="25.1">
    <requirements>
        <credentials name="quiet_service" version="1.0">
            <secret name="API_TOKEN" inject_as_env="API_TOKEN"/>
        </credentials>
    </requirements>
    <command><![CDATA[
        echo "token length \${#API_TOKEN}" > '$output'
    ]]></command>
    <inputs/>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test>
            <credentials name="quiet_service">
                <secret name="API_TOKEN" value="fake_token_4c1d2e"/>
            </credentials>
            <output name="output">
                <assert_contents>
                    <has_text text="token length 17"/>
                </assert_contents>
            </output>
        </test>
    </tests>
</tool>
