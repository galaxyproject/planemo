<tool id="leaks_credential_secret" name="leaks_credential_secret" version="1.0.0" profile="25.1">
    <requirements>
        <credentials name="leaky_service" version="1.0">
            <secret name="API_TOKEN" inject_as_env="API_TOKEN"/>
        </credentials>
    </requirements>
    <command><![CDATA[
        echo "request rejected for token \$API_TOKEN" >&2 &&
        echo "done" > '$output'
    ]]></command>
    <inputs/>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test>
            <credentials name="leaky_service">
                <secret name="API_TOKEN" value="fake_token_4c1d2e"/>
            </credentials>
            <output name="output">
                <assert_contents>
                    <has_text text="done"/>
                </assert_contents>
            </output>
        </test>
    </tests>
</tool>
