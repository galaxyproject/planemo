<tool id="leaks_credential_secret_in_collection" name="leaks_credential_secret_in_collection" version="1.0.0" profile="25.1">
    <requirements>
        <credentials name="leaky_service" version="1.0">
            <secret name="API_TOKEN" inject_as_env="API_TOKEN"/>
        </credentials>
    </requirements>
    <command><![CDATA[
        echo "token \$API_TOKEN" > '$pair.forward' &&
        echo "done" > '$pair.reverse'
    ]]></command>
    <inputs/>
    <outputs>
        <collection name="pair" type="paired">
            <data name="forward" format="txt"/>
            <data name="reverse" format="txt"/>
        </collection>
    </outputs>
    <tests>
        <test>
            <credentials name="leaky_service">
                <secret name="API_TOKEN" value="fake_token_4c1d2e"/>
            </credentials>
            <output_collection name="pair" type="paired">
                <element name="reverse">
                    <assert_contents>
                        <has_text text="done"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
    </tests>
</tool>
