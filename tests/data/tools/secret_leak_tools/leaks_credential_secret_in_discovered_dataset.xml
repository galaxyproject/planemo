<tool id="leaks_credential_secret_in_discovered_dataset" name="leaks_credential_secret_in_discovered_dataset" version="1.0.0" profile="25.1">
    <requirements>
        <credentials name="leaky_service" version="1.0">
            <secret name="API_TOKEN" inject_as_env="API_TOKEN"/>
        </credentials>
    </requirements>
    <command><![CDATA[
        mkdir parts &&
        echo "token \$API_TOKEN" > parts/a.txt &&
        echo "done" > parts/b.txt
    ]]></command>
    <inputs/>
    <outputs>
        <collection name="parts" type="list">
            <discover_datasets pattern="__name_and_ext__" directory="parts"/>
        </collection>
    </outputs>
    <tests>
        <test>
            <credentials name="leaky_service">
                <secret name="API_TOKEN" value="fake_token_4c1d2e"/>
            </credentials>
            <output_collection name="parts" type="list" count="2"/>
        </test>
    </tests>
</tool>
