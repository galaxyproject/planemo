<tool id="leaks_credential_secret_on_failure" name="leaks_credential_secret_on_failure" version="1.0.0" profile="25.1">
    <requirements>
        <credentials name="leaky_service" version="1.0">
            <secret name="API_TOKEN" inject_as_env="API_TOKEN"/>
        </credentials>
    </requirements>
    <command><![CDATA[
        echo "partial" > '$output' &&
        echo "401 Unauthorized for token \$API_TOKEN" >&2 &&
        exit 1
    ]]></command>
    <inputs/>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test expect_failure="true" expect_exit_code="1">
            <credentials name="leaky_service">
                <secret name="API_TOKEN" value="fake_token_4c1d2e"/>
            </credentials>
        </test>
    </tests>
</tool>
