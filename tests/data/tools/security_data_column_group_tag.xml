<tool id="security_data_column_group_tag" name="Security Column And Tag Fixture" version="1.0">
    <description>fixture for the planemo security linter</description>
    <command><![CDATA[
--tag '$tagvalue.value' --column '$columnvalue' > '$output1';
#for $column in $columnvalue:
--column '$column'
#end for
    ]]></command>
    <inputs>
        <param name="tagvalue" type="group_tag" data_ref="collection1" label="Tag"/>
        <param name="columnvalue" type="data_column" data_ref="input1" multiple="true" label="Column"/>
        <param name="input1" type="data" format="txt" label="Input dataset"/>
        <param name="collection1" type="data_collection" collection_type="list" optional="true" label="List collection"/>
    </inputs>
    <outputs>
        <data name="output1" format="txt"/>
    </outputs>
    <tests>
        <test expect_failure="true">
            <param name="input1" value="1.bed"/>
            <param name="tagvalue" value="sample:T1"/>
            <param name="columnvalue" value="1"/>
        </test>
    </tests>
    <help>
        Fixture tool exercising group tag and data column findings for the security linter.
    </help>
    <citations>
        <citation type="doi">10.5072/planemo-fixture</citation>
    </citations>
</tool>
